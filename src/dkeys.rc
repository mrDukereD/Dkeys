#include <winver.h>
1 ICON "dkeys.ico"

1 VERSIONINFO
FILEVERSION 1,0,3,0
PRODUCTVERSION 1,0,3,0
FILEFLAGSMASK 0x3fL
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DKeys"
            VALUE "FileVersion", "1.0.3"
            VALUE "InternalName", "DKeys"
            VALUE "OriginalFilename", "DKeys.exe"
            VALUE "ProductName", "DKeys"
            VALUE "ProductVersion", "1.0.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
